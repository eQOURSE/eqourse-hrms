[Unit]
Description=Upload encrypted Horilla database and media backups
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/eqourse-hrms
EnvironmentFile=/etc/horilla/backup.env
ExecStart=/usr/bin/bash /opt/eqourse-hrms/deploy/backup.sh
UMask=0077
TimeoutStartSec=30min
